#!/bin/bash
# probe: one line for Bot Code's idle rule. `cpu_usec` is the CPU time the whole container
# has used so far, from its cgroup, so two probes give its average load in between; `clients`
# is how many Desktop tabs are connected; `desktop` is whether the desktop runs at all.
set -u
cpu=$(awk '/^usage_usec/ { print $2 }' /sys/fs/cgroup/cpu.stat 2>/dev/null)
if [[ -z $cpu ]]; then
  cpu=$(( $(cat /sys/fs/cgroup/cpu/cpuacct.usage 2>/dev/null || echo 0) / 1000 ))
fi
clients=$(/opt/botcode/bin/desktop clients)
if /opt/botcode/bin/desktop status >/dev/null 2>&1; then desktop=1; else desktop=0; fi
printf 'cpu_usec=%s clients=%s desktop=%s\n' "$cpu" "$clients" "$desktop"
