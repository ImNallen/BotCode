#!/bin/bash
set -euo pipefail
DIVERGED_EXIT=3
BLOCKED_EXIT=4
cd /workspace
export GIT_AUTHOR_NAME="L1 Code" GIT_AUTHOR_EMAIL=l1code@users.noreply.github.com
export GIT_COMMITTER_NAME="L1 Code" GIT_COMMITTER_EMAIL=l1code@users.noreply.github.com
export GIT_AUTHOR_DATE="1970-01-01T00:00:00Z" GIT_COMMITTER_DATE="1970-01-01T00:00:00Z"
export GIT_TERMINAL_PROMPT=0 LC_ALL=C
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE

g() { git -c core.fsmonitor=false -c core.splitIndex=false -c core.hooksPath=/dev/null "$@"; }
real_index() { g rev-parse --path-format=absolute --git-path index; }
sync_index() { g rev-parse --path-format=absolute --git-path l1code-sync-index; }

head_spec() {
  local ref
  if ref=$(g symbolic-ref -q HEAD); then
    if g rev-parse -q --verify 'HEAD^{commit}' >/dev/null; then
      echo "branch ${ref#refs/heads/}"
    else
      echo "unborn ${ref#refs/heads/}"
    fi
  else
    echo detached
  fi
}

untracked_files() {
  local path
  while IFS= read -r -d '' path; do
    [[ $path == */ ]] || printf '%s\0' "$path"
  done
}

worktree_tree() {
  local real sync
  real=$(real_index)
  sync=$(sync_index)
  if [[ -f $real ]]; then cp -f "$real" "$sync"; else rm -f "$sync"; fi
  (
    export GIT_INDEX_FILE=$sync
    [[ -f $sync ]] || g read-tree --empty
    g update-index --no-split-index
    g ls-files -z | g update-index --no-assume-unchanged --no-skip-worktree -z --stdin
    g add -u -- .
    g ls-files --others --exclude-per-directory=.gitignore -z | untracked_files | g update-index --add -z --stdin
    g write-tree
  )
}

index_tree() {
  local tmp
  if g write-tree 2>/dev/null; then return; fi
  tmp=$(mktemp)
  cp -f "$(real_index)" "$tmp"
  GIT_INDEX_FILE=$tmp g ls-files --unmerged -z | cut -z -f2 | sort -zu \
    | GIT_INDEX_FILE=$tmp g update-index --force-remove -z --stdin
  GIT_INDEX_FILE=$tmp g write-tree
  rm -f "$tmp"
}

capture() {
  local index worktree spec tree parent
  index=$(index_tree)
  worktree=$(worktree_tree)
  spec=$(head_spec)
  tree=$(printf '040000 tree %s\tindex\n040000 tree %s\tworktree\n' "$index" "$worktree" | g mktree)
  if parent=$(g rev-parse -q --verify 'HEAD^{commit}'); then
    g commit-tree "$tree" -p "$parent" -m l1code-sync -m "head: $spec"
  else
    g commit-tree "$tree" -m l1code-sync -m "head: $spec"
  fi
}

head_of() { g log -1 --format='%P %B' "$1"; }
changed() { g diff-tree -r --name-only -z "$1" "$2" | sort -zu; }

set_head() {
  local spec=$1 commit=$2
  case $spec in
    branch\ *)
      g update-ref "refs/heads/${spec#branch }" "$commit"
      g symbolic-ref HEAD "refs/heads/${spec#branch }"
      ;;
    detached) g update-ref --no-deref HEAD "$commit" ;;
    unborn\ *) g symbolic-ref HEAD "refs/heads/${spec#unborn }" ;;
    *) echo "sync: unknown head '$spec'" >&2; exit 1 ;;
  esac
}

apply() {
  local base=$1 incoming=$2 base_tree new_tree current collisions spec commit
  base_tree=$(g rev-parse --verify "$base:worktree")
  new_tree=$(g rev-parse --verify "$incoming:worktree")
  current=$(capture)
  collisions=$(mktemp)
  {
    if [[ $current != "$base" ]]; then
      [[ $(head_of "$current") == "$(head_of "$base")" ]] || printf 'head\t\0'
      comm -z -12 <(changed "$base_tree" "$new_tree") <(changed "$base_tree" "$current:worktree") \
        | sed -z 's/^/worktree\t/'
      changed "$base:index" "$current:index" | sed -z 's/^/index\t/'
    fi
    # git would overwrite an ignored file in the way without a word.
    comm -z -23 <(changed "$base_tree" "$new_tree") <(g ls-tree -r --name-only -z "$current:worktree" | sort -zu) \
      | while IFS= read -r -d '' path; do
          if [[ -e $path || -L $path ]]; then printf 'blocked\t%s\0' "$path"; fi
        done
  } >"$collisions"
  if [[ -s $collisions ]]; then
    cat "$collisions"
    rm -f "$collisions"
    exit "$DIVERGED_EXIT"
  fi
  rm -f "$collisions"
  (
    export GIT_INDEX_FILE
    GIT_INDEX_FILE=$(sync_index)
    g read-tree --reset "$base_tree"
    g update-index -q --unmerged --refresh
    g read-tree -m -u "$base_tree" "$new_tree" || exit "$BLOCKED_EXIT"
  ) || exit $?
  spec=$(g log -1 --format=%B "$incoming" | sed -n 's/^head: //p' | head -n 1)
  commit=$(g rev-parse -q --verify "$incoming^{commit}^" 2>/dev/null || true)
  set_head "$spec" "$commit"
  g read-tree --reset "$incoming:index"
  g update-index -q --unmerged --refresh
  g update-ref refs/l1code/sync/base "$incoming"
}

seed() {
  local bundle=$1
  shift
  local spec=$*
  find /workspace -mindepth 1 -delete
  g -c init.defaultBranch=main init --quiet /workspace
  case $spec in
    branch\ *)
      g fetch --quiet --update-head-ok "$bundle" "+refs/heads/${spec#branch }:refs/heads/${spec#branch }"
      g symbolic-ref HEAD "refs/heads/${spec#branch }"
      ;;
    detached)
      g fetch --quiet "$bundle" HEAD
      g update-ref --no-deref HEAD "$(g rev-parse FETCH_HEAD)"
      ;;
    unborn\ *) g symbolic-ref HEAD "refs/heads/${spec#unborn }" ;;
    *) echo "sync: unknown head '$spec'" >&2; exit 1 ;;
  esac
  if g rev-parse -q --verify 'HEAD^{commit}' >/dev/null; then
    g reset --quiet --hard
  fi
  if [[ -n ${L1_CODE_USER_NAME-} ]]; then git config user.name "$L1_CODE_USER_NAME"; fi
  if [[ -n ${L1_CODE_USER_EMAIL-} ]]; then git config user.email "$L1_CODE_USER_EMAIL"; fi
  if [[ $bundle != - ]]; then rm -f "$bundle"; fi
}

case ${1-} in
  capture)
    commit=$(capture)
    g update-ref refs/l1code/sync/outgoing "$commit"
    if [[ -n ${2-} ]]; then g update-ref refs/l1code/sync/base "$2"; fi
    echo "$commit"
    ;;
  apply) apply "$2" "$3" ;;
  seed) shift; seed "$@" ;;
  *) echo "usage: sync capture [host-base] | apply <base> <incoming> | seed <bundle|-> <head...>" >&2; exit 2 ;;
esac
