#!/usr/bin/python3
# The relay lets the Mac reach servers that listen only on the container's loopback, which
# Docker cannot publish.
import asyncio
import fcntl
import hmac
import os
import re
import socket
import subprocess
import sys
import time

STATE = "/dev/shm/l1code-gateway"
TOKEN = f"{STATE}/token"
PORT = 6081
HEADER_TIMEOUT = 10


def listening():
    try:
        socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
        return True
    except OSError:
        return False


def start():
    os.umask(0o077)
    os.makedirs(STATE, exist_ok=True)
    with open(f"{STATE}/lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        secret = sys.stdin.readline().strip()
        if not re.fullmatch(r"[A-Za-z0-9]{16,128}", secret):
            print("gateway: invalid secret", file=sys.stderr)
            return 2
        with open(f"{TOKEN}.new", "w") as file:
            file.write(secret)
        os.replace(f"{TOKEN}.new", TOKEN)
        if not listening():
            subprocess.Popen(
                [sys.executable, __file__, "serve"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        for _ in range(200):
            if listening():
                return 0
            time.sleep(0.05)
    print("gateway: the relay did not come up", file=sys.stderr)
    return 1


async def target(port):
    for host in ("127.0.0.1", "::1"):
        try:
            return await asyncio.open_connection(host, port)
        except OSError:
            pass
    return None


async def pipe(reader, writer):
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
        if writer.can_write_eof():
            writer.write_eof()
    except OSError:
        writer.close()


async def relay(client_reader, client_writer):
    upstream = None
    try:
        line = await asyncio.wait_for(
            client_reader.readuntil(b"\n"), HEADER_TIMEOUT
        )
        token, port = line.decode("ascii").split()
        with open(TOKEN) as file:
            expected = file.read().strip()
        port = int(port)
        if not hmac.compare_digest(token, expected) or not 0 < port < 65536:
            return
        upstream = await target(port)
        if upstream is None:
            return
        reader, writer = upstream
        await asyncio.gather(pipe(client_reader, writer), pipe(reader, client_writer))
    except (
        OSError,
        ValueError,
        asyncio.TimeoutError,
        asyncio.IncompleteReadError,
        asyncio.LimitOverrunError,
    ):
        pass
    finally:
        client_writer.close()
        if upstream is not None:
            upstream[1].close()


async def serve():
    server = await asyncio.start_server(relay, "0.0.0.0", PORT)
    await server.serve_forever()


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "start":
        sys.exit(start())
    if command == "serve":
        asyncio.run(serve())
        sys.exit(0)
    print("usage: gateway start", file=sys.stderr)
    sys.exit(2)
