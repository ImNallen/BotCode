#!/bin/bash
set -u
cpu=$(awk '/^usage_usec/ { print $2 }' /sys/fs/cgroup/cpu.stat 2>/dev/null)
if [[ -z $cpu ]]; then
  cpu=$(( $(cat /sys/fs/cgroup/cpu/cpuacct.usage 2>/dev/null || echo 0) / 1000 ))
fi
clients=$(/opt/l1code/bin/desktop clients)
if /opt/l1code/bin/desktop status >/dev/null 2>&1; then desktop=1; else desktop=0; fi
printf 'cpu_usec=%s clients=%s desktop=%s\n' "$cpu" "$clients" "$desktop"
awk 'FNR > 1 && $4 == "0A"' /proc/net/tcp /proc/net/tcp6 2>/dev/null
