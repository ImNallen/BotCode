{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z1 Code",
  "version": "0.1.0",
  "identifier": "dev.z1.code",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Z1 Code",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
